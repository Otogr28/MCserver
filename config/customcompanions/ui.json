{
  // Presentation knobs for the companion panel (Codex). Edit and reopen the panel to apply
  // (or /reload). Colors are "#AARRGGBB" (alpha-red-green-blue), or "#RRGGBB" for an opaque color.

  "tooltipHoverMs": 1900,         // ms the mouse must rest on an ability row (e.g. Spirit Equip passives/actives)
                                  //   before its description tooltip appears; 0 = show immediately

  "spiritEnvelopOverlay": true,   // show the root-tendril frame around the screen while your Spirit envelops you
                                  //   (the X ability). Set false to keep the screen clear when you trigger it.

  "luminaLabelSource": "picto",   // which name a learned lumina shows (Luminas list + "Lumina learned" chat):
                                  //   "picto"   = the picto's flavour name, so picto and lumina read the same
                                  //               (e.g. Swift / Swift) — default
                                  //   "passive" = the underlying passive primitive's generic name (e.g. Rush,
                                  //               Momentum). The lumina tooltip always shows the full effect either way.

  "statRadar": {
    // The hexagonal stat radar at the top of the Stats tab (one axis per attribute).
    "referenceMin": 8.0,          // the web scales to max(referenceMin, your highest attribute): a low-level
                                  //   companion shows a small web instead of one pinned to the outer edge
    "fillColor": "#66C8A23A",     // translucent gold fill of the web
    "gridColor": "#66554F6E",     // the background grid rings + spokes
    "outlineColor": "#FFE6C766",  // the web outline + vertex dots
    "labelColor": "#FFD8D5E0"     // the attribute names around the chart
  },

  "summoner": {
    // The summoner Equip tab shows each summon's Size as a row of pips (one pip per army slot it costs).
    "sizePip": "◆",          // the glyph for one Size slot (default ◆); e.g. set "*" or "#" if ◆ won't render
    "sizePipColor": "#54A9F0",    // color of the Size pips (default blue)
    "rowHeight": 18               // vertical spacing of each summon row; raise for a roomier list, lower to fit more
  },

  "luminaBar": {
    // The textless progress bar under each equipped picto's name (Pictos tab): fills with kills toward learning
    // its Lumina, then turns blue once full/learned. Kills needed per rarity live in picto.json (killsToLearnByRarity).
    "trackColor": "#FF15152A",    // the empty track behind the fill
    "progressColor": "#FFFFC233", // gold — the bar as it fills with kills
    "completeColor": "#FF4FA8FF"  // blue — the full bar once the Lumina is learned
  }
}
