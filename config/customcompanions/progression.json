{
  // Shared attribute progression for ALL companion classes. Everything here is a "per point" rate so it's easy
  // to tune: one allocated point of an attribute grants this much of its effect (equipped pictos add on top
  // through the same pipeline). Edit + /reload (or restart) to apply.

  "perPoint": {
    "vitality": 4.0,        // +max health per point          (all classes)
    "might": 0.6,           // +attack damage per point        (warrior)
    "agility": 0.004,       // +movement speed per point       (all classes)
    "defense": 1.0,         // +armor points per point         (all classes)
    "luck": 1.0,            // +% crit CHANCE per point         (warrior)
    "intelligence": 25.0,   // +max mana per point             (mage)
    "grace": 1.0,           // +aura power per point           (spirit)  — feeds auraAmpPerPoint below
    "command": 1.0          // +army power per point           (summoner) — feeds armySlotsPerPoint below
  },

  // How the special mechanics scale (all per-point so you can dial them directly):
  "critBonus": 0.5,         // crit DAMAGE: a critical hit deals this much extra (0.5 = +50% on the hit)
  "armySlotsPerPoint": 0.2, // Summoner: +summon slots per Army point (0.2 = 5 points → +1 slot; total is floored)
  "auraPointsPerAmp": 12.0, // Spirit: Aura points needed for +1 buff amplifier level (lower = stronger aura)
  "auraAmpCap": 2           // ...capped at this many extra amplifier levels on the aura buffs
}
