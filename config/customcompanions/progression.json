{
  // Shared attribute progression for ALL companion classes. Everything here is a "per point" rate so it's easy
  // to tune: one allocated point of an attribute grants this much of its effect (equipped pictos add on top
  // through the same pipeline). Edit + /reload (or restart) to apply.

  // Lowered for a slower, more gradual progression (each point steps the stat up less, so growth is steadier).
  "perPoint": {
    "vitality": 2.0,        // +max health per point          (all classes)
    "might": 0.35,          // +attack damage per point        (warrior)
    "agility": 0.0025,      // +movement speed per point       (all classes)
    "defense": 0.6,         // +armor points per point         (all classes)
    "luck": 0.6,            // +% crit CHANCE per point         (warrior)
    "intelligence": 16.0,   // +max mana per point             (mage)
    "grace": 0.7,           // +aura power per point           (spirit)  — feeds auraAmpPerPoint below
    "command": 0.7          // +army power per point           (summoner) — feeds armySlotsPerPoint below
  },

  // How the special mechanics scale (all per-point so you can dial them directly):
  "critBonus": 0.5,         // crit DAMAGE: a critical hit deals this much extra (0.5 = +50% on the hit)
  "armySlotsPerPoint": 0.2, // Summoner: +summon slots per Army point (0.2 = 5 points → +1 slot; total is floored)
  // Spirit aura: spread the curve so Grace keeps mattering past mid-game (was capped at amp 2 by ~level 15).
  "auraPointsPerAmp": 18.0, // Aura points needed for +1 buff amplifier level (raised → smoother scaling to 50)
  "auraAmpCap": 3           // ...capped at this many extra amplifier levels on the aura buffs (was 2)
}
