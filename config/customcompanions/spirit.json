{
  // Spirit support class — a floating soul-wisp at your side (SpiritBalance.java). It has an always-on PASSIVE
  // (Equip > Passives) and an ACTIVE (Equip > Actives) applied when you Envelop (press X). All tunable live.
  // passive: the always-on perk's numbers (Hunger Saver / Slow Regen). Much subtler than the old Speed/Regen
  // aura (removed). You select which passive in the Equip tab.
  "passive": {
    "intervalTicks": 40,            // generic tick gate
    "radius": 16.0,                 // you must be within this for passives to apply (the wisp follows you)
    "hungerSlowFraction": 0.5,      // Hunger Saver: refund this fraction of exhaustion (0.5 = hunger 50% slower).
                                    // The Equip > Passives label shows this as a %, derived live from this value.
    "regenIntervalTicks": 60,      // Slow Regen: heal every N ticks (120 = 6s) — constant but super slow
    "regenAmount": 2.0              // Slow Regen: HP healed each interval
  },
  // envelop: the burst on the Spirit keybind (default X) — the wisp merges into you for a limited time,
  // giving strong buffs PLUS a share of the Spirit's own combat stats. In your own first-person view the aura
  // particles are hidden and you instead get a colour root-frame around the screen edge (others still see the
  // particle aura on you).
  "envelop": {
    "durationTicks": 160,    // 8s enveloped
    "cooldownTicks": 600,    // 30s cooldown AFTER it ends (tracked per-player + persisted, so disabling/
                             // re-enabling the spirit or relogging can't reset it)
    "refreshTicks": 40,      // how often the active's effects are re-applied while active
    // NOTE: there is no longer an always-on base potion burst — the envelop applies ONLY the SELECTED active's
    // described effects (see "modes" below; Grace adds to the active's primary amplifier). With no active bound,
    // the keybind does nothing. The only thing the envelop always does is the stat-inheritance "merge":
    // Stat inheritance: fraction of the Spirit's attribute value added to YOU for the duration.
    "healthTransfer": 0.5,   // +50% of the Spirit's max health as bonus hearts
    "attackTransfer": 1.0,   // +100% of the Spirit's attack damage
    "armorTransfer": 1.0,    // +100% of the Spirit's armor
    "speedTransfer": 0.5     // +50% of the Spirit's movement-speed bonus
  },
  // wisp: the Spirit has no model — its colour is per-companion (picked in the create/Appearance UI and
  // stored in modelPreset as color:RRGGBB). The same colour tints both the in-world particle wisp and the
  // glowing orb shown in the create/panel preview. defaultColor is only the tint a freshly created Spirit gets.
  "wisp": {
    "defaultColor": "7FC8FF",   // spectral blue (RRGGBB hex)
    "followDistance": 2.0,      // side-float only (aboveHead=false): how far (blocks) the wisp hovers from you
    "aboveHead": true,          // hover directly ABOVE your head (sits on top of you, never lands in the crosshair —
                                // it used to float at face height and block your hits/mining/block placement).
                                // false = old side-float at head height (uses followDistance).
    "aboveHeadOffset": 0.7      // blocks of clearance kept above your head when aboveHead is on
    // NOTE: the wisp particle-density knobs (for FPS) live in ui.json (client-side), NOT here — spirit.json only
    // loads on the SERVER, and the wisp is drawn on each client. See config/customcompanions/ui.json.
  },
  // modes: the ACTIVE modes (Equip > Actives). One selected; its effect is applied ONLY during the Envelop
  // (press X), on top of the base burst. The wisp's tone shifts slightly toward the active's colour (kept
  // small so your chosen colour dominates).
  "modes": {
    "moonGrace": {
      "jumpAmplifier": 2        // Jump Boost III during the envelop — jump higher (violet tint)
    },
    "berserker": {
      "strengthAmplifier": 1,   // extra Strength during the envelop — more damage dealt (red tint)
      "damageTakenMultiplier": 1.3  // ...but you take x1.3 incoming damage WHILE enveloped (the cost)
    },
    "bulwark": {
      "resistanceAmplifier": 3, // Resistance IV during the envelop — soak hits (steel-blue tint)
      "slownessAmplifier": 1    // ...but Slowness II while enveloped (the cost)
    },
    "phantomStep": {
      "bonusSpeed": 2           // extra Speed on top of the base envelop Speed + a brief Invisibility (pale tint)
    },
    "wrath": {
      "strengthBonus": 2,       // extra Strength on top of the base burst (molten tint)
      "hasteAmplifier": 1       // Haste II during the envelop
    }
  }
}
