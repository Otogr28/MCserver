{
  // Spirit support class — a floating soul-wisp at your side (SpiritBalance.java). It keeps a light
  // passive aura on you, and on the "Spirit: Envelop" keybind (default X) it merges into you for a
  // limited time: strong buffs + a share of its own combat stats. All numbers below are tunable live.
  // passive: the light aura it keeps on you just by floating nearby (a gentle Speed/Regen hum;
  // Grace does NOT scale the passive — it scales the Envelop burst below).
  "passive": {
    "intervalTicks": 40,     // refresh cadence
    "durationTicks": 100,    // effect duration each refresh (> interval, so it never flickers)
    "radius": 16.0,          // you must be within this for the passive aura to land
    "speedAmplifier": 0,     // 0 = Speed I
    "regenAmplifier": 0      // 0 = Regen I
  },
  // envelop: the burst on the Spirit keybind (default X) — the wisp merges into you for a limited time,
  // giving strong buffs PLUS a share of the Spirit's own combat stats.
  "envelop": {
    "durationTicks": 160,    // 8s enveloped
    "cooldownTicks": 600,    // 30s cooldown AFTER it ends
    "refreshTicks": 40,      // how often the potion effects are re-applied while active
    // Potion amplifiers (Grace + the Spirit's ability nodes add on top, capped by progression.json auraAmpCap).
    "speedAmplifier": 1,
    "regenAmplifier": 1,
    "strengthAmplifier": 1,
    "resistanceAmplifier": 1,
    "fireResistance": true,
    // Stat inheritance: fraction of the Spirit's attribute value added to YOU for the duration.
    "healthTransfer": 0.5,   // +50% of the Spirit's max health as bonus hearts
    "attackTransfer": 1.0,   // +100% of the Spirit's attack damage
    "armorTransfer": 1.0,    // +100% of the Spirit's armor
    "speedTransfer": 0.5     // +50% of the Spirit's movement-speed bonus
  },
  // wisp: the Spirit has no model — its colour is per-companion (picked in the create/Appearance UI and
  // stored in modelPreset as color:RRGGBB). The same colour tints both the in-world particle wisp and the
  // glowing orb shown in the create/panel preview. defaultColor is only the tint a freshly created Spirit gets.
  "wisp": {
    "defaultColor": "7FC8FF"  // spectral blue (RRGGBB hex)
  },
  // modes: Equip-tab attunement (one active at a time; an always-on boon while the wisp floats near you, plus
  // a subtle shift of the wisp's tone toward the mode's colour — kept small so your chosen colour dominates).
  "modes": {
    "moonGrace": {
      "jumpAmplifier": 2        // Jump Boost III — jump higher (violet tint)
    },
    "berserker": {
      "strengthAmplifier": 1,   // Strength II — more damage dealt (red tint)
      "damageTakenMultiplier": 1.3  // ...but you take x1.3 incoming damage (the cost)
    }
  }
}
