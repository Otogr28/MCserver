{
  // Roguelike progression draft (DraftConfig.java). Every few levels a companion earns an "unlock token";
  // spending it opens a "pick 1 of N" chooser drawn from that class's ability nodes, gated by level bands so
  // strong nodes can't appear early. All live-tunable (re-read on /reload).
  "unlockEveryLevels": 5,   // grant one unlock token every N levels (0 = never)
  "choicesPerDraft": 3,     // how many nodes each draft offers — you pick one
  "rerollEnabled": false,   // reserved: allow re-rolling the current offer (not wired yet)
  // Cumulative level bands: each band that has opened (level >= opensAtLevel) raises the pool ceiling. The
  // offer may include any node whose requiredLevel <= the current ceiling — so the pool widens as you level
  // ("1-10", then "1-20", then "1-30").
  "bands": [
    { "opensAtLevel": 1,  "poolCeiling": 10 },
    { "opensAtLevel": 15, "poolCeiling": 20 },
    { "opensAtLevel": 25, "poolCeiling": 30 }
  ],
  // Rarity -> offer weight (higher = appears more often). Rarer nodes are deliberately scarcer in the draft.
  "rarityWeights": {
    "common": 100,
    "uncommon": 60,
    "rare": 30,
    "epic": 12,
    "legendary": 5
  }
}
