{
  // Appearance editor + the two companion-panel header buttons.
  // minSize/maxSize/sizeStep: the model-scale range and step the "Appearance" editor enforces.
  "minSize": 0.3,
  "maxSize": 2.5,
  "sizeStep": 0.1,
  // The three toggles below are enforced server-side (the buttons are always drawn so the LDLib panel
  // matches on both sides; a disallowed action just no-ops with a chat notice).
  // allowModelChange: allow re-styling an existing companion via the "Appearance" button.
  "allowModelChange": true,
  // allowClassChange: let the editor switch the companion's CLASS when editing an existing companion.
  // Off by default — changing class mid-progression re-arms and rescales; the editor only restyles.
  "allowClassChange": false,
  // allowDisable: allow the "Disable / Enable" button (despawn the companion, keep ALL its data).
  //   Re-enabling a companion that was Disabled while DEAD revives it to full (never spawns a stuck corpse).
  "allowDisable": true,
  // codexOpenFallbackTicks: Codex open safety net. The Codex opens via a client ack (the client applies the
  //   ownership data, then asks the server to open) so the create-vs-panel UI never desyncs under lag. If that
  //   ack is ever LOST (dropped packet), the server opens the Codex anyway after this many ticks so it can't
  //   silently fail to open. 20 ticks = 1s. Set to 0 to disable the fallback (pure ack-only).
  "codexOpenFallbackTicks": 40
}
