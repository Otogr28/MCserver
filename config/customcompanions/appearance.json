{
  // Appearance editor + the two companion-panel header buttons.
  // minSize/maxSize/sizeStep: the model-scale range and step the "Appearance" editor enforces.
  "minSize": 0.3,
  "maxSize": 2.5,
  "sizeStep": 0.1,
  // defaultModel: the curated model a freshly-created companion (and any unknown/legacy preset, e.g. an old
  //   "robot") falls back to. Use an id from companion/models_index.json (e.g. "ars_starbuncle", "paimon",
  //   "cri_red_panda"). This replaced the old blue/red placeholder cubes. If the id isn't found, any loaded
  //   curated model is used before the built-in placeholder, so a typo never brings the dev cube back.
  "defaultModel": "ars_starbuncle",
  // The toggles below are enforced server-side. For the panel buttons (allowModelChange/allowDisable) the
  // button is always drawn so the LDLib panel matches on both sides and a disallowed action just no-ops with
  // a chat notice; allowCasterSkins instead hides the "MC skin" field client-side and the server forces the
  // preset back if one slips through.
  // allowModelChange: allow re-styling an existing companion via the "Appearance" button.
  "allowModelChange": true,
  // allowClassChange: let the editor switch the companion's CLASS when editing an existing companion.
  // Off by default — changing class mid-progression re-arms and rescales; the editor only restyles.
  "allowClassChange": false,
  // allowDisable: allow the "Disable / Enable" button (despawn the companion, keep ALL its data).
  //   Re-enabling a companion that was Disabled while DEAD revives it to full (never spawns a stuck corpse).
  "allowDisable": true,
  // allowCasterSkins: let a CASTER (summoner/mage) wear a Minecraft player skin — "mc:<username>" or a
  //   curated skin id — instead of a GeckoLib model, rendering it as a humanoid biped like the warrior.
  //   When false, the create screen + appearance editor hide the "MC skin" field for casters and the server
  //   forces a caster's skin preset back to the default model. The warrior is unaffected (it always wears a
  //   skin). Enforced server-side, like the toggles above.
  "allowCasterSkins": true,
  // codexOpenFallbackTicks: Codex open safety net. The Codex opens via a client ack (the client applies the
  //   ownership data, then asks the server to open) so the create-vs-panel UI never desyncs under lag. If that
  //   ack is ever LOST (dropped packet), the server opens the Codex anyway after this many ticks so it can't
  //   silently fail to open. 20 ticks = 1s. Set to 0 to disable the fallback (pure ack-only).
  "codexOpenFallbackTicks": 40
}
