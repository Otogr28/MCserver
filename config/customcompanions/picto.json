{
  // Picto / Lumina tuning (PictoConfig.java). Edit + /reload (or restart) to apply.
  // Loot is automatic: on open, each chest rolls pictoDropByRarity per tier to add a Picto (no command needed).
  "killsToLearnLumina": 12,   // fallback only — used if killsToLearnByRarity is removed/null
  // Kills (with the picto EQUIPPED) to LEARN its lumina, scaled by rarity: commons are quick to master, legendaries
  // a long grind. The Pictos tab shows a textless progress bar under each equipped picto's name (rarity-tinted,
  // turns gold when learned). Tune freely + /reload.
  "killsToLearnByRarity": {
    "common": 5,
    "uncommon": 10,
    "rare": 15,
    "epic": 20,
    "legendary": 25
  },
  "lumenPerLevel": 1,         // lumen (lumina-point budget) gained per companion level
  // Spirit pictos progress toward their luminas from the OWNER PLAYER's kills (the spirit IS the player).
  // false (default) = the player's kills always count. true = only kills landed while the Spirit Active (Envelop)
  // is running count. (Summoner pictos always progress from their summons' kills; warrior/mage from their own.)
  "spiritProgressRequiresActive": false,
  // Per-chest drop chance for a picto of EACH rarity (rolled independently — commons common, legendaries rare).
  // A dropped picto is unidentified + rarity-locked; right-click opens a DRAFT to choose one picto of that rarity
  // for your companion's class (see draftChoicesByRarity). The offer is frozen onto the item (no re-roll); the
  // item is consumed only when you pick.
  "pictoDropByRarity": {
    "common": 0.06,
    "uncommon": 0.03,
    "rare": 0.012,
    "epic": 0.005,
    "legendary": 0.0025
  },
  // Only inject pictos into real CHEST containers. Many barrels/dispensers in dungeons reuse a "chests/" loot
  // table, so the table id alone would over-spawn pictos in barrels; this also requires the opened container's
  // block entity to be a chest (vanilla/trapped/most modded chests). false = any matching loot table (old behavior).
  "onlyChestBlocks": true,
  // How many distinct pictos the right-click draft offers you to choose from, per rarity (always >= 1).
  // Pool = unowned pictos of that rarity usable by the companion's class; if fewer exist, fewer are shown.
  // Catalog after the 2026-06-18 rework (per class = general + that class) — the real pool caps are:
  //   common 7 (6 general + 1 class) · uncommon 8 (6 + 2) · rare 7 (5 + 2) · epic 3 (2 + 1) · legendary 0 (none yet).
  // So the defaults below never over-ask, EXCEPT legendary: a legendary picto item finds an empty pool and is NOT
  // consumed until legendary pictos exist. (Before the rework, common was the SCARCEST tier — that's why a common
  // draft dried up after a couple of picks; the rework flattened the curve so common now has the most depth.)
  "draftChoicesByRarity": {
    "common": 4,
    "uncommon": 3,
    "rare": 2,
    "epic": 1,
    "legendary": 2
  },
  "lumenDropChance": 0.06,    // chance per chest to add a Lumen item
  // A loot table is treated as a chest if its id contains any of these. "chests/" is the universal
  // structure-chest convention (vanilla + ~every structure mod), so this already covers nearly all modded
  // chests. Add a mod's own pattern here if its chests use a non-standard path.
  "chestTablePatterns": ["chests/"]
}
